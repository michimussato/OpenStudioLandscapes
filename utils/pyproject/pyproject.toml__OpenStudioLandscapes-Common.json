{
  "build-system": {
    "build-backend": "setuptools.build_meta",
    "requires": [
      "setuptools>=80",
      "setuptools-scm>=9"
    ]
  },
  "project": {
    "authors": [
      {
        "email": "michimussato@gmail.com",
        "name": "Michael Mussato"
      }
    ],
    "classifiers": [
      "Development Status :: 4 - Beta",
      "Programming Language :: Python",
      "Framework :: OpenStudioLandscapes"
    ],
    "dependencies": [
      "importlib-metadata; python_version<\"3.8\"",
      "dagster==1.9.11",
      "gitpython",
      "PyYAML",
      "snakemd",
      "docker-compose-graph @ git+https://github.com/michimussato/docker-compose-graph.git@v1.0.0",
      "OpenStudioLandscapes @ git+https://github.com/michimussato/OpenStudioLandscapes@v1.8.0-rc1"
    ],
    "dynamic": [
      "version"
    ],
    "entry-points": {},
    "license-files": [
      "LICENSE.txt"
    ],
    "maintainers": [
      {
        "email": "michimussato@gmail.com",
        "name": "Michael Mussato"
      }
    ],
    "optional-dependencies": {
      "coverage": [
        "coverage",
        "pytest"
      ],
      "dev": [
        "dagster-webserver==1.9.11"
      ],
      "graphviz": [
        "graphviz",
        "pipdeptree"
      ],
      "lint": [
        "black",
        "isort",
        "pre-commit",
        "pylint"
      ],
      "nox": [
        "nox"
      ],
      "readme": [
        "OpenStudioLandscapesUtil-ReadmeGenerator @ git+https://github.com/michimussato/OpenStudioLandscapesUtil-ReadmeGenerator.git@v1.8.0-rc1"
      ],
      "sbom": [
        "cyclonedx-bom"
      ],
      "testing": [
        "setuptools",
        "pytest",
        "pytest-cov"
      ]
    },
    "readme": {
      "content-type": "text/markdown; charset=UTF-8",
      "file": "README.md"
    },
    "requires-python": ">=3.11",
    "urls": {
    }
  },
  "tool": {
    "setuptools": {
      "packages": {
        "find": {
          "exclude": [
            "tests"
          ],
          "namespaces": true,
          "where": [
            "src"
          ]
        }
      },
      "include-package-data": true,
      "platforms": [
        "Linux"
      ]
    }
  }
}